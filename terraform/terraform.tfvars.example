project_id = "gold-courage-498911-e4"
region     = "asia-south1"
zone       = "asia-south1-a"

cluster_name = "ai-platform"
environment  = "dev"

node_machine_type   = "e2-standard-4"
node_pool_min_count = 1
node_pool_max_count = 3
use_spot_nodes      = true

# Tighten this to your IP for real hardening: "YOUR_IP/32"
master_authorized_cidr = "0.0.0.0/0"
