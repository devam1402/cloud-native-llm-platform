# Copy to minio-storage.yaml, apply manually (gitignored).
# Tells KServe how to reach MinIO as an S3 endpoint.
apiVersion: v1
kind: Secret
metadata:
  name: minio-storage
  namespace: kserve
  annotations:
    serving.kserve.io/s3-endpoint: "minio.minio.svc.cluster.local:9000"
    serving.kserve.io/s3-usehttps: "0"      # MinIO is plain HTTP in-cluster
    serving.kserve.io/s3-region: "us-east-1"
stringData:
  AWS_ACCESS_KEY_ID: "admin"
  AWS_SECRET_ACCESS_KEY: "changeme-platform-2026"
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: minio-sa
  namespace: kserve
secrets:
  - name: minio-storage
